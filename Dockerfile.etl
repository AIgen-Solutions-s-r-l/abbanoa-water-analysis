# ETL Docker container for CSV import
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install Python dependencies
RUN pip install --no-cache-dir \
    pandas==2.1.4 \
    psycopg2-binary==2.9.9 \
    numpy==1.25.2

# Copy scripts
COPY scripts/import_csv_to_postgres.py /app/
COPY DATA /app/DATA

# Default command
CMD ["python", "import_csv_to_postgres.py"]